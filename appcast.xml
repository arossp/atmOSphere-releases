        <item>
            <title>0.8.34</title>
            <pubDate>Tue, 10 Nov 2026 17:47:41 -0700</pubDate>
            <sparkle:version>51</sparkle:version>
            <sparkle:shortVersionString>0.8.34</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description><![CDATA[<ul>
<li>Animated GIFs fit inside posts, including in narrow conversation panes.</li>
<li>Smooth and pixelated Dock icons use more colors from the selected theme.</li>
<li>Notifications focus on conversations and follows. Likes and reposts are removed, and interacting with a post clears its notification in the app.</li>
<li>Reply and quote controls respect the author’s settings.</li>
<li>Feed removal is in the right-click menu. Done buttons use the app’s typeface.</li>
<li>The About window links to the atmOSphere account on Bluesky.</li>
</ul>
]]></description>
            <enclosure url="https://github.com/arossp/atmOSphere-releases/releases/download/v0.8.34/atmOSphere.zip" length="49385368" type="application/octet-stream" sparkle:edSignature="mfBvMx8kAlnNBcjcL3VRdliGKmIVWPPv3Vw05aB17st7OyB3CGs9OTIbT3zjt73zJ3/hjgHyRDqbAJ8kRGzYCg=="/>
